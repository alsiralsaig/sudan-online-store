      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/sanad-icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/sanad-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/sanad-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-mobile.png",
      "sizes": "430x932",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "تطبيق سند للمتسوقين - واجهة المتجر على الهاتف"
    },
    {
      "src": "/screenshots/wide-desktop.png",
      "sizes": "1600x640",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة إدارة السند - التحكم الشامل بنقاط البيع والفروع"
    }
  ],
  "shortcuts": [
    {
      "name": "كاشير سند - نقطة البيع",
      "short_name": "كاشير",
      "description": "تشغيل نقطة البيع السحابية وإدارة المبيعات",
      "url": "/?app=merchant",
      "icons": [
        {
          "src": "/icons/sanad-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "متجر سند - تسوق",
      "short_name": "متجر",
      "description": "تصفح الكتالوج والطلب المسبق",
      "url": "/?app=client",
      "icons": [
        {
          "src": "/icons/sanad-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "إدارة السند - المنصة المركزية",
      "short_name": "الإدارة",
      "description": "لوحة التحكم المركزية للمشرف العام",
      "url": "/?app=super_admin",
      "icons": [
        {
          "src": "/icons/sanad-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "/?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+sanad",
      "url": "/?app=client&shared=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/?import=1",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://sudan-online-store-eta.vercel.app"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "widgets": [
    {
      "name": "سند - ملخص اليوم",
      "short_name": "سند",
      "description": "مبيعات اليوم والفواتير المعلّقة ونواقص المخزون",
      "tag": "sanad-daily-summary",
      "template": "sanad-daily-summary",
      "ms_ac_template": "/widgets/sanad-widget.json",
      "data": "/widgets/data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [
        {
          "src": "/icons/sanad-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "screenshots": [
        {
          "src": "/screenshots/wide-desktop.png",
          "sizes": "1600x640",
          "type": "image/png"
        }
      ]
    }
  ]
}