{
  "id": "/",
  "name": "سند - المنصة السحابية للتجارة ونقاط البيع الذكية",
  "short_name": "سند POS",
  "description": "منصة سحابية متكاملة متعددة المتاجر والفروع لنقاط البيع السحابية وتطبيق المتسوقين في السودان، تدعم العمل أوفلاين وتعدد العملات.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "theme_color": "#052e1a",
  "background_color": "#052e1a",
  "lang": "ar",
  "dir": "rtl",
  "prefer_related_applications": false,
  "categories": [
    "shopping",
    "business",
    "finance",
    "productivity"
  ],
  "icons": [
