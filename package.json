    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:test": "tsx scripts/test-db.ts",
    "db:test:api": "tsx scripts/test-api.ts",
    "db:clean-tests": "tsx scripts/clean-tests.ts",
    "db:test:media": "tsx scripts/test-media.ts",
    "db:test:ads": "tsx scripts/test-market-ads.ts",
    "db:test:tenants": "tsx scripts/test-tenant-applications.ts",
    "db:test:notify": "tsx scripts/test-notifications.ts",
    "db:test:notify-auto": "tsx scripts/test-notifications-auto.ts",
    "db:test:assistant": "tsx scripts/test-assistant.ts",
    "test:media-range": "tsx scripts/test-media-range.ts",
    "test:storage": "tsx scripts/test-storage.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.0.0",
