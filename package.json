    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
