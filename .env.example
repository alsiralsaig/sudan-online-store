# ============================================================================
#  Sanad POS & Commerce — متغيّرات البيئة
# ----------------------------------------------------------------------------
#  كل المتغيّرات هنا اختيارية ولها قيم افتراضية داخل الكود، ما عدا
#  DATABASE_URL و GEMINI_API_KEY (الأول لتشغيل قاعدة البيانات، والثاني
#  لتشغيل المساعد الذكي بالذكاء الاصطناعي).
#
#  طريقة الاستخدام محلياً:
#     cp .env.example .env      ثم عدّل القيم داخل .env
#
#  على Vercel:
#     Project → Settings → Environment Variables
#     أضف الاسم في Key والقيمة في Value (Production + Preview)
#     ثم Deployments → ⋯ → Redeploy  (القيم تُقرأ عند تشغيل السيرفر فقط)
# ============================================================================

# ---------------------------------------------------------------------------
#  1) قاعدة البيانات — Neon Postgres  [مطلوب للتشغيل الكامل]
# ---------------------------------------------------------------------------
#  بدونها يعمل السيرفر في الذاكرة فقط (البيانات تُفقد مع كل إعادة تشغيل).
#  الصيغة (استخدم رابط الـ pooler من لوحة Neon):
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

#  حد أقصى لاتصالات الـ pool (افتراضي 3 — مناسب لـ Serverless)
#  PG_POOL_MAX=3


# ---------------------------------------------------------------------------
#  2) المساعد الذكي (Gemini)  [مطلوب لتشغيل المساعد]
# ---------------------------------------------------------------------------
#  المفتاح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

#  بديل اختياري لنفس المفتاح (يُقرأ إذا كان GEMINI_API_KEY فارغاً)
#  GOOGLE_API_KEY=""

#  تثبيت موديل معيّن بدل السلسلة التلقائية
#  (gemini-flash-latest → gemini-3-flash-preview → gemini-3.1-flash-lite → gemini-2.5-flash)
#  GEMINI_MODEL="gemini-flash-latest"

#  موديل تحويل النص إلى كلام للقراءة الصوتية
#  GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"


# ---------------------------------------------------------------------------
#  3) الإشعارات على الهاتف (Web Push)  [اختياري]
# ---------------------------------------------------------------------------
#  إذا تُركت فارغة، يُنشئ السيرفر زوج مفاتيح VAPID تلقائياً ويحفظه
#  في جدول pushKeys داخل قاعدة البيانات — وهذا يكفي تماماً.
#  املأها فقط إذا أردت المفاتيح ثابتة خارج قاعدة البيانات.
#  توليد زوج جديد:  npx web-push generate-vapid-keys
#  VAPID_PUBLIC_KEY=""
#  VAPID_PRIVATE_KEY=""

#  جهة الاتصال المرفقة بمفاتيح VAPID (بريدك أو بريد الدعم)
#  VAPID_CONTACT="mailto:admin@sanad.sd"


# ---------------------------------------------------------------------------
#  4) الرسوم والأسعار  [اختياري — القيم الافتراضية هي المفعلة الآن]
# ---------------------------------------------------------------------------
#  رسوم نشر إعلان في السوق: العادي و VIP (بالجنيه السوداني، أرقام فقط)
#  AD_FEE_STANDARD_SDG=0
#  AD_FEE_VIP_SDG=5000

#  قيمة تسجيل المتجر الجديد عند الموافقة (بالجنيه السوداني، أرقام فقط)
#  TENANT_REGISTRATION_FEE_SDG=50000

#  ملاحظة: هذه الأرقام تُعرض للمستخدم، ويمكن للإدارة تعديل قيمة تسجيل
#  كل متجر على حدة من تبويب «طلبات المتاجر» عند الموافقة.


# ---------------------------------------------------------------------------
#  5) متفرقات  [اختياري]
# ---------------------------------------------------------------------------
#  الرابط العام للتطبيق (يُستخدم في الروابط الذاتية)
#  BASE_URL="https://sudan-online-store-eta.vercel.app"

#  APP_URL: خاص ببيئة AI Studio — غير مطلوب على Vercel
#  APP_URL=""
